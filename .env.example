# Copie para .env apenas se for rodar o frontend fora da pipeline.
# Estes dois valores são públicos por design (protegidos por RLS).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-ou-publishable-key>

# NUNCA coloque aqui: service_role key, senha do banco, tokens da Cloudflare.
# Esses ficam só em GitHub Secrets / Supabase Secrets.
